# Running App - 后端环境配置示例
# 复制此文件为 .env 并根据实际情况修改配置

[APP]
# 应用调试模式（生产环境请设置为false）
APP_DEBUG = true
# 应用Trace
APP_TRACE = false

[DATABASE]
# 数据库类型
TYPE = mysql
# 数据库服务器地址
HOSTNAME = 127.0.0.1
# 数据库名
DATABASE = running_app
# 数据库用户名
USERNAME = root
# 数据库密码（请修改为实际密码）
PASSWORD = your_password_here
# 数据库端口
HOSTPORT = 3306
# 数据库连接参数
CHARSET = utf8mb4
# 数据库表前缀
PREFIX =

[JWT]
# JWT密钥（生产环境务必修改为复杂随机字符串，建议32位以上）
SECRET_KEY = your_random_secret_key_here_change_this_in_production
# Token过期时间（秒），默认7天
EXPIRE_TIME = 604800
# Refresh Token过期时间（秒），默认30天
REFRESH_EXPIRE_TIME = 2592000

[CACHE]
# 缓存类型
TYPE = file
# 缓存前缀
PREFIX = running_app_

[SESSION]
# Session类型
TYPE = file
# Session前缀
PREFIX = running_app_

[UPLOAD]
# 上传文件大小限制（MB）
MAX_SIZE = 10
# 允许上传的文件类型
ALLOW_EXT = jpg,jpeg,png,gif,webp

[SMS]
# 短信服务商（aliyun/tencent/huawei）
PROVIDER = aliyun

# 阿里云短信配置
ALIYUN_ACCESS_KEY_ID = your_aliyun_access_key_id
ALIYUN_ACCESS_KEY_SECRET = your_aliyun_access_key_secret
ALIYUN_SIGN_NAME = Running App
ALIYUN_TEMPLATE_CODE = SMS_123456789

# 腾讯云短信配置
TENCENT_SECRET_ID = your_tencent_secret_id
TENCENT_SECRET_KEY = your_tencent_secret_key
TENCENT_SDK_APP_ID = your_sdk_app_id
TENCENT_SIGN_NAME = Running App
TENCENT_TEMPLATE_ID = 123456

[REALAUTH]
# 实名认证服务商（aliyun/tencent）
PROVIDER = aliyun

# 阿里云实名认证配置
ALIYUN_ACCESS_KEY_ID = your_aliyun_access_key_id
ALIYUN_ACCESS_KEY_SECRET = your_aliyun_access_key_secret
ALIYUN_REGION_ID = cn-hangzhou

# 腾讯云实名认证配置
TENCENT_SECRET_ID = your_tencent_secret_id
TENCENT_SECRET_KEY = your_tencent_secret_key
TENCENT_REGION = ap-guangzhou

[WECHAT]
# 微信开放平台配置
APP_ID = your_wechat_app_id
APP_SECRET = your_wechat_app_secret

[QQ]
# QQ互联配置
APP_ID = your_qq_app_id
APP_KEY = your_qq_app_key

[APPLE]
# Apple登录配置
CLIENT_ID = your_apple_client_id
TEAM_ID = your_apple_team_id
KEY_ID = your_apple_key_id
PRIVATE_KEY_PATH = /path/to/AuthKey.p8
