# ThinkPHP 应用配置示例
# 复制此文件为 .env 并根据实际情况修改配置

[APP]
# 应用调试模式
APP_DEBUG = true
# 应用Trace
APP_TRACE = false

[DATABASE]
# 数据库类型
TYPE = mysql
# 数据库服务器地址
HOSTNAME = 127.0.0.1
# 数据库名
DATABASE = running_app
# 数据库用户名
USERNAME = root
# 数据库密码（请修改为实际密码）
PASSWORD = your_password_here
# 数据库端口
HOSTPORT = 3306
# 数据库连接参数
CHARSET = utf8mb4
# 数据库表前缀
PREFIX =

[JWT]
# JWT密钥（请修改为随机字符串，建议32位以上）
SECRET_KEY = your_random_secret_key_here_change_this_in_production
# Token过期时间（秒），默认7天
EXPIRE_TIME = 604800
# Refresh Token过期时间（秒），默认30天
REFRESH_EXPIRE_TIME = 2592000

[CACHE]
# 缓存类型
TYPE = file
# 缓存前缀
PREFIX = running_app_

[SESSION]
# Session类型
TYPE = file
# Session前缀
PREFIX = running_app_

[UPLOAD]
# 上传文件大小限制（MB）
MAX_SIZE = 10
# 允许上传的文件类型
ALLOW_EXT = jpg,jpeg,png,gif

[SMS]
# 短信服务商（aliyun/tencent）
PROVIDER = aliyun
# 短信AccessKey
ACCESS_KEY = your_access_key_here
# 短信SecretKey
SECRET_KEY = your_secret_key_here
# 短信签名
SIGN_NAME = 跑步应用
# 短信模板ID
TEMPLATE_CODE = SMS_123456789

[WECHAT]
# 微信小程序AppID
APP_ID = your_wechat_app_id
# 微信小程序AppSecret
APP_SECRET = your_wechat_app_secret
