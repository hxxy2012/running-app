# 生产环境配置示例
# 复制此文件为 .env 并修改相应配置

[APP]
# 应用调试模式（生产环境必须为false）
APP_DEBUG = false

# 应用跟踪（生产环境关闭）
APP_TRACE = false

# 时区
APP_TIMEZONE = Asia/Shanghai

# API域名
API_DOMAIN = https://api.your-domain.com

[DATABASE]
# 数据库类型
DB_TYPE = mysql

# 数据库服务器地址
DB_HOSTNAME = 127.0.0.1

# 数据库端口
DB_HOSTPORT = 3306

# 数据库名
DB_DATABASE = running_app

# 用户名
DB_USERNAME = running_app_user

# 密码（请使用强密码）
DB_PASSWORD = your_secure_database_password_here

# 数据库编码
DB_CHARSET = utf8mb4

# 数据库表前缀
DB_PREFIX =

# 数据库连接参数
DB_PARAMS = []

# 数据库部署方式：0 集中式（单一服务器），1 分布式（主从服务器）
DB_DEPLOY = 0

# 数据库读写是否分离
DB_RW_SEPARATE = false

# 读操作主服务器数量
DB_MASTER_NUM = 1

# 指定从服务器序号
DB_SLAVE_NO =

# 是否开启断线重连
DB_BREAK_RECONNECT = true

[REDIS]
# Redis主机
REDIS_HOST = 127.0.0.1

# Redis端口
REDIS_PORT = 6379

# Redis密码（请使用强密码）
REDIS_PASSWORD = your_secure_redis_password_here

# Redis数据库索引（0-15）
REDIS_SELECT = 0

# Redis键前缀
REDIS_PREFIX = running_app:

# Redis超时时间（秒）
REDIS_TIMEOUT = 0

[CACHE]
# 缓存驱动（file, redis）
CACHE_DRIVER = redis

# 缓存前缀
CACHE_PREFIX = running_app:

# 缓存有效期（秒，0为永久）
CACHE_EXPIRE = 0

[SESSION]
# Session驱动
SESSION_DRIVER = redis

# Session有效期（秒）
SESSION_EXPIRE = 7200

[QUEUE]
# 队列驱动（sync, database, redis）
QUEUE_DRIVER = redis

# Redis队列数据库索引
REDIS_QUEUE_SELECT = 1

[JWT]
# JWT密钥（至少32字符，请使用随机生成的强密钥）
JWT_SECRET = your_jwt_secret_key_at_least_32_characters_long

# JWT有效期（秒，7天）
JWT_TTL = 604800

# JWT刷新有效期（秒，30天）
JWT_REFRESH_TTL = 2592000

[SMS]
# 短信服务商（aliyun, tencent）
SMS_PROVIDER = aliyun

# 阿里云短信配置
SMS_ALIYUN_ACCESS_KEY_ID = your_aliyun_access_key_id
SMS_ALIYUN_ACCESS_KEY_SECRET = your_aliyun_access_key_secret
SMS_ALIYUN_SIGN_NAME = your_sign_name
SMS_ALIYUN_TEMPLATE_CODE = your_template_code

# 腾讯云短信配置
SMS_TENCENT_SECRET_ID = your_tencent_secret_id
SMS_TENCENT_SECRET_KEY = your_tencent_secret_key
SMS_TENCENT_SDK_APP_ID = your_sdk_app_id
SMS_TENCENT_SIGN_NAME = your_sign_name
SMS_TENCENT_TEMPLATE_ID = your_template_id

[OSS]
# 对象存储服务商（aliyun, qiniu, tencent）
OSS_PROVIDER = aliyun

# 阿里云OSS配置
OSS_ALIYUN_ACCESS_KEY_ID = your_aliyun_oss_access_key
OSS_ALIYUN_ACCESS_KEY_SECRET = your_aliyun_oss_secret_key
OSS_ALIYUN_BUCKET = your_bucket_name
OSS_ALIYUN_ENDPOINT = oss-cn-hangzhou.aliyuncs.com
OSS_ALIYUN_CDN_DOMAIN = https://cdn.your-domain.com

[WECHAT]
# 微信公众号配置
WECHAT_OFFICIAL_APP_ID = your_wechat_app_id
WECHAT_OFFICIAL_APP_SECRET = your_wechat_app_secret

# 微信小程序配置
WECHAT_MINI_APP_ID = your_mini_app_id
WECHAT_MINI_APP_SECRET = your_mini_app_secret

# 微信支付配置
WECHAT_PAY_MCH_ID = your_mch_id
WECHAT_PAY_KEY = your_pay_key
WECHAT_PAY_CERT_PATH = /path/to/cert/apiclient_cert.pem
WECHAT_PAY_KEY_PATH = /path/to/cert/apiclient_key.pem

[ALIPAY]
# 支付宝配置
ALIPAY_APP_ID = your_alipay_app_id
ALIPAY_PRIVATE_KEY = your_private_key
ALIPAY_PUBLIC_KEY = alipay_public_key
ALIPAY_SIGN_TYPE = RSA2

[EMAIL]
# 邮件发送配置
EMAIL_HOST = smtp.example.com
EMAIL_PORT = 465
EMAIL_USERNAME = noreply@your-domain.com
EMAIL_PASSWORD = your_email_password
EMAIL_FROM_ADDRESS = noreply@your-domain.com
EMAIL_FROM_NAME = Running App
EMAIL_ENCRYPTION = ssl

[LOG]
# 日志级别（emergency, alert, critical, error, warning, notice, info, debug）
LOG_LEVEL = error

# 日志文件大小限制（字节）
LOG_FILE_SIZE = 10485760

# 日志保留天数
LOG_DAYS = 30

[MONITOR]
# 是否启用Prometheus监控
MONITOR_PROMETHEUS_ENABLED = true

# 是否启用健康检查
MONITOR_HEALTH_CHECK_ENABLED = true

[SECURITY]
# 是否启用CORS
CORS_ENABLED = true

# 允许的域名（多个用逗号分隔，*表示全部）
CORS_ALLOWED_ORIGINS = https://your-domain.com,https://www.your-domain.com

# API限流（每分钟最大请求数）
RATE_LIMIT_MAX_REQUESTS = 100
RATE_LIMIT_TIME_WINDOW = 60

# 是否启用SQL注入防护
SQL_INJECTION_PROTECTION = true

# 是否启用XSS防护
XSS_PROTECTION = true
