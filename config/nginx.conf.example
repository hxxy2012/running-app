# ====================================
# Running App - Nginx配置示例
# ====================================
#
# 这是一个优化的Nginx配置示例，包含：
# - 性能优化
# - 安全加固
# - HTTPS配置
# - 缓存策略
# - 压缩配置
#
# 使用方法:
# 1. 复制此文件到 /etc/nginx/sites-available/running-app
# 2. 修改域名和路径
# 3. 创建软链接: ln -s /etc/nginx/sites-available/running-app /etc/nginx/sites-enabled/
# 4. 测试配置: nginx -t
# 5. 重载Nginx: systemctl reload nginx
# ====================================

# HTTP服务器 - 重定向到HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name example.com www.example.com;

    # ACME challenge for Let's Encrypt
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # 强制HTTPS
    location / {
        return 301 https://$server_name$request_uri;
    }
}

# HTTPS服务器
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name example.com www.example.com;

    # ====================================
    # SSL配置
    # ====================================

    ssl_certificate /etc/ssl/certs/example.com.crt;
    ssl_certificate_key /etc/ssl/private/example.com.key;

    # SSL协议和加密套件
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES256-GCM-SHA512:DHE-RSA-AES256-GCM-SHA512:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers on;

    # SSL Session缓存
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;

    # OCSP Stapling
    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 8.8.8.8 8.8.4.4 valid=300s;
    resolver_timeout 5s;

    # ====================================
    # 安全Headers
    # ====================================

    # HSTS (HTTP Strict Transport Security)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    # 防止点击劫持
    add_header X-Frame-Options "SAMEORIGIN" always;

    # XSS防护
    add_header X-XSS-Protection "1; mode=block" always;

    # 防止MIME类型嗅探
    add_header X-Content-Type-Options "nosniff" always;

    # Referrer Policy
    add_header Referrer-Policy "no-referrer-when-downgrade" always;

    # CSP (Content Security Policy)
    add_header Content-Security-Policy "default-src 'self' http: https: data: blob: 'unsafe-inline'; frame-ancestors 'self';" always;

    # Permissions Policy
    add_header Permissions-Policy "geolocation=(self), microphone=(), camera=()" always;

    # ====================================
    # 基础配置
    # ====================================

    root /var/www/running-app/backend/public;
    index index.php index.html;

    charset utf-8;

    # 最大上传大小
    client_max_body_size 10M;

    # 超时配置
    client_body_timeout 12;
    client_header_timeout 12;
    send_timeout 10;

    # ====================================
    # Gzip压缩
    # ====================================

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml text/javascript
               application/json application/javascript application/xml+rss
               application/rss+xml application/atom+xml image/svg+xml
               text/x-component text/x-cross-domain-policy;
    gzip_disable "msie6";

    # ====================================
    # 日志配置
    # ====================================

    access_log /var/log/nginx/running-app-access.log combined;
    error_log /var/log/nginx/running-app-error.log warn;

    # ====================================
    # 路由配置
    # ====================================

    # 隐藏.git目录
    location ~ /\.git {
        deny all;
        return 404;
    }

    # 隐藏其他敏感文件
    location ~ /\.(env|htaccess) {
        deny all;
        return 404;
    }

    # 禁止访问composer文件
    location ~ /(composer\.json|composer\.lock|package\.json) {
        deny all;
        return 404;
    }

    # 静态文件缓存
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot)$ {
        expires 1M;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # ThinkPHP路由
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # PHP处理
    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;

        # PHP-FPM配置
        fastcgi_pass unix:/var/run/php/php8.1-fpm.sock;  # 根据实际PHP版本调整
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;

        # 超时设置
        fastcgi_connect_timeout 60;
        fastcgi_send_timeout 180;
        fastcgi_read_timeout 180;

        # 缓冲设置
        fastcgi_buffer_size 128k;
        fastcgi_buffers 4 256k;
        fastcgi_busy_buffers_size 256k;
        fastcgi_temp_file_write_size 256k;

        # FastCGI缓存（可选）
        # fastcgi_cache_bypass $skip_cache;
        # fastcgi_no_cache $skip_cache;
        # fastcgi_cache RUNNING_APP;
        # fastcgi_cache_valid 200 60m;
    }

    # 禁止访问runtime目录
    location ~ ^/runtime/ {
        deny all;
        return 404;
    }

    # robots.txt
    location = /robots.txt {
        allow all;
        log_not_found off;
        access_log off;
    }

    # favicon.ico
    location = /favicon.ico {
        log_not_found off;
        access_log off;
    }

    # ====================================
    # API速率限制（可选）
    # ====================================

    # 在http块中定义限制区域:
    # limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;

    # location /api/ {
    #     limit_req zone=api burst=20 nodelay;
    #     try_files $uri $uri/ /index.php?$query_string;
    # }
}

# ====================================
# 额外的优化建议
# ====================================

# 1. 在http块中添加FastCGI缓存:
# fastcgi_cache_path /var/cache/nginx/running-app levels=1:2
#                    keys_zone=RUNNING_APP:100m inactive=60m;
# fastcgi_cache_key "$scheme$request_method$host$request_uri";

# 2. 配置速率限制:
# limit_req_zone $binary_remote_addr zone=login:10m rate=5r/m;
# limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;

# 3. 配置连接限制:
# limit_conn_zone $binary_remote_addr zone=addr:10m;
# limit_conn addr 10;

# 4. 优化worker进程:
# worker_processes auto;
# worker_connections 1024;

# 5. 启用HTTP/2 Push（可选）:
# http2_push_preload on;
