# Running App Docker 环境变量配置
# 复制此文件为 .env 并根据实际情况修改

# ==================== 数据库配置 ====================
DB_ROOT_PASSWORD=root123456
DB_DATABASE=running_app
DB_USERNAME=running
DB_PASSWORD=running123
DB_PORT=3306

# ==================== 后端配置 ====================
BACKEND_PORT=8000

# ==================== Redis 配置 ====================
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# ==================== 应用配置 ====================
# 应用调试模式
APP_DEBUG=false

# 应用密钥（用于加密，请使用随机字符串）
APP_KEY=base64:your-random-32-character-string

# JWT 密钥（请使用随机字符串）
JWT_SECRET=your-jwt-secret-key

# ==================== 短信服务配置 ====================
# 服务商: aliyun, tencent, huawei
SMS_PROVIDER=aliyun

# 阿里云短信
SMS_ALIYUN_ACCESS_KEY_ID=
SMS_ALIYUN_ACCESS_KEY_SECRET=
SMS_ALIYUN_SIGN_NAME=Running App
SMS_ALIYUN_TEMPLATE_CODE=SMS_123456789

# ==================== 实名认证配置 ====================
# 服务商: aliyun, tencent
REALAUTH_PROVIDER=aliyun

# 阿里云实名认证
REALAUTH_ALIYUN_ACCESS_KEY_ID=
REALAUTH_ALIYUN_ACCESS_KEY_SECRET=
REALAUTH_ALIYUN_REGION_ID=cn-hangzhou

# ==================== 对象存储配置 ====================
# OSS 服务商: aliyun, tencent, qiniu
OSS_PROVIDER=aliyun

# 阿里云 OSS
OSS_ALIYUN_ACCESS_KEY_ID=
OSS_ALIYUN_ACCESS_KEY_SECRET=
OSS_ALIYUN_BUCKET=running-app
OSS_ALIYUN_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ALIYUN_DOMAIN=https://running-app.oss-cn-hangzhou.aliyuncs.com

# ==================== 第三方登录配置 ====================
# 微信开放平台
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# QQ 互联
QQ_APP_ID=
QQ_APP_KEY=

# Apple Sign In
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
